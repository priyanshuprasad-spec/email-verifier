# ============================================================
#  Email Validator — Environment Configuration
# ============================================================

# --- Server ---
PORT=3000

# --- Validation ---
# Enable SMTP probing (port 25 must be open outbound on your server)
# WARNING: Disabled by default. Cloud providers (AWS/GCP/Azure) block port 25.
# Set to true only on bare-metal or VPS servers.
ENABLE_SMTP=false

# Timeout (ms) for DNS lookups
DNS_TIMEOUT_MS=5000

# Timeout (ms) for SMTP connection attempts
SMTP_TIMEOUT_MS=10000

# Maximum emails in bulk validation endpoint
BULK_MAX_EMAILS=50

# --- Cache ---
# Time-to-live for cached results (in seconds). 3600 = 1 hour
CACHE_TTL_SECONDS=3600

# --- Rate Limiting ---
# Max requests per IP per window
RATE_LIMIT_MAX=100
# Window duration in milliseconds
RATE_LIMIT_WINDOW_MS=60000
